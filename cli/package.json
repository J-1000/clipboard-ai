{
  "name": "cbai",
  "version": "0.1.0",
  "description": "CLI for clipboard-ai - AI lookups & summaries triggered from your clipboard",
  "type": "module",
  "bin": {
    "cbai": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "openai": "^6.49.0",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/yargs": "^17.0.32",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
